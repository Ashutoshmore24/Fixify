  classDef decisionNode fill:#f59e0b,stroke:#d97706,stroke-width:2px,color:#ffffff
  classDef coreNode fill:#0284c7,stroke:#0369a1,stroke-width:1.5px,color:#ffffff
  classDef errNode fill:#ef4444,stroke:#dc2626,stroke-width:1.5px,color:#ffffff
